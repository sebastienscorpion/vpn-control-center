# ipsec.conf - strongSwan IPsec configuration file

# basic configuration

config setup
	
	
    charondebug="ike 2, knl 2, cfg 2"

conn site-to-site
    type=tunnel
    keyexchange=ikev2

    left=192.168.100.3
    leftid=192.168.100.3
    leftsubnet=10.10.0.0/24

    right=192.168.100.4
    rightid=192.168.100.4
    rightsubnet=10.20.0.0/24

    authby=psk

    ike=aes256-sha256-modp2048
    esp=aes256-sha256

    auto=start

conn Maconnexion
    # Généré par VPN Control Center
    keyexchange=ikev1
    left=192.168.100.9
    leftsubnet=10.70.0.0/24
    right=192.168.100.10
    rightsubnet=10.80.0.0/24
    authby=secret
    ike=aes128-md5-modp768!
    esp=aes128-md5-modp768!
    ikelifetime=86400s
    lifetime=28800s
    rekey=no
    type=tunnel
    dpdaction=restart
    dpddelay=30s
    dpdtimeout=120s
    auto=add
